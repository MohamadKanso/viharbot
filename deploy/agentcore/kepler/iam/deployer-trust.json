{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheFounderSsoRoleMayAssume",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::ACCOUNT_ID:root" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::ACCOUNT_ID:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AWSAdministratorAccess_*"
        }
      }
    }
  ]
}
